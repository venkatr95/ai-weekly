# Optional. The default index is ./data/index under the current directory.
# MEETING_INDEX_DIR=data/index

# sidecar uses a transcript next to the recording.
# whisper uses a local faster-whisper model and does not call a cloud API.
# MEETING_TRANSCRIBER=sidecar
# MEETING_WHISPER_MODEL=base

# MEETING_MAX_TEXT_BYTES=2000000
# MEETING_MAX_AUDIO_BYTES=200000000

# Drop dated meetings older than this many days. Unset keeps every meeting.
# MEETING_RETENTION_DAYS=365
