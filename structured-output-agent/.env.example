# Choose which LLM provider powers extraction: gemini | anthropic | openai | grok
LLM_PROVIDER=gemini

# Optional: override the default model for the chosen provider
# (defaults: gemini=gemini-2.0-flash, anthropic=claude-sonnet-4-5, openai=gpt-4o, grok=grok-3)
# LLM_MODEL=

# Paste the API key for whichever provider you plan to use.
# Only the key matching LLM_PROVIDER needs to be set.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
