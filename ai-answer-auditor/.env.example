# heuristic checks claims offline. Set xai to call the model provider.
AUDITOR_PROVIDER=heuristic

# Used only when AUDITOR_PROVIDER=xai. Do not commit a real key.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Leave at 0. Source text is not written to logs unless this is 1.
AUDITOR_LOG_SOURCES=0
