# Choose which LLM provider powers chat/digest: anthropic | openai | gemini | grok
LLM_PROVIDER=anthropic

# Optional: override the default model for the chosen provider
# (defaults: anthropic=claude-sonnet-5, openai=gpt-5.1, gemini=gemini-3-pro, grok=grok-4.1)
# LLM_MODEL=

# Paste the API key for whichever provider(s) you plan to use below.
# Only the key matching LLM_PROVIDER needs to be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
