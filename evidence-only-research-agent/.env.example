# Copy to .env and fill in only the providers you use.
# .env is gitignored. Do not commit real keys.

# extractive answers offline and quotes source sentences.
# xai sends retrieved passages to the xAI API (https://api.x.ai/v1).
# openai_compatible sends them to the base URL you set, including a local server.
GENERATION_PROVIDER=extractive

# Used only when GENERATION_PROVIDER=xai.
# Create a key at https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Used only when GENERATION_PROVIDER=openai_compatible.
# Example for Ollama: base URL http://127.0.0.1:11434/v1 and model llama3.2
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# local uses hashed TF-IDF and does not call the network.
# http expects an OpenAI-compatible POST /embeddings endpoint.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

INDEX_DIR=data/index
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=6
SIMILARITY_THRESHOLD=0.15
SUPPORT_THRESHOLD=0.55
LOG_DOCUMENT_TEXT=false
REQUEST_TIMEOUT_SECONDS=60
