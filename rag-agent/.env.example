# SpaceXAI / xAI. The LLM and the embedding model both use this key.
# Leave it empty to run offline: hashing embeddings and an extractive answerer.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=embed-latest
REASONING_EFFORT=low

# memory: no Docker required. postgres: docker compose overrides this.
VECTOR_STORE=memory
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Word-and-punctuation tokens. Overlap must be smaller than the chunk size.
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
TOP_K=5
# Optional overrides. Unset uses a provider-specific default.
# MIN_SCORE=0.18
# VECTOR_WEIGHT=0.45
LOG_LEVEL=INFO
